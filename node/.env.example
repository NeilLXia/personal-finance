# Server
NODE_ENV=development
APP_PORT=8001
SESSION_COOKIE_NAME=finance_session
SESSION_SECRET=replace-with-a-long-random-string
SESSION_MAX_AGE_SECONDS=2592000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUST_PROXY=1

# Auth allowlist
# Development may leave this blank to allow any verified Google account.
# Production requires comma-separated allowed emails; blank production values block Google sign-in.
ALLOWED_AUTH_EMAILS=

# Rate limits
RATE_LIMIT_GENERAL_MAX=1000
RATE_LIMIT_AUTH_MAX=40
RATE_LIMIT_DASHBOARD_MAX=300
RATE_LIMIT_SYNC_MAX=30
RATE_LIMIT_ADDRESS_SEARCH_MAX=120
RATE_LIMIT_MUTATION_MAX=120
RATE_LIMIT_UPLOAD_MAX=20

# AWS KMS token encryption
# Use a symmetric KMS key. In AWS, prefer IAM role credentials over long-lived keys.
AWS_REGION=us-east-1
AWS_KMS_KEY_ID=replace-with-kms-key-id-or-arn

# Database
# Prefer DATABASE_URL in production. Use DB_* for local Docker/Postgres.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=finance
DB_USER=finance
DB_PASSWORD=devpassword
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
# DB_SSL_CA_PATH=/path/to/database-ca.pem
# DB_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# When set, database credentials are loaded from AWS Secrets Manager at startup
# (uses AWS_REGION and the ambient AWS credentials). Overrides DB_PASSWORD/DB_USER
# and, when a connection string is also present, DATABASE_URL. Leave DB_HOST/
# DB_PORT/DB_NAME set for the target you want; the secret only fills them if unset.
# Accepts an RDS-managed JSON secret ({username,password,host,port,dbname}) or a
# raw password string.
# DB_SECRET_ID=arn:aws:secretsmanager:us-east-2:123456789012:secret:rds!db-xxxxxxxx

# Plaid
PLAID_ENV=sandbox
PLAID_CLIENT_ID=replace-with-plaid-client-id
PLAID_SANDBOX_SECRET=replace-with-plaid-sandbox-secret
PLAID_PRODUCTION_SECRET=replace-with-plaid-production-secret
PLAID_REQUEST_TIMEOUT_MS=30000
PLAID_TRANSACTION_SYNC_MAX_PAGES=20
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=US
PLAID_REDIRECT_URI=
PLAID_WEBHOOK_URL=
PLAID_TRANSACTIONS_DAYS_REQUESTED=730
PLAID_LINK_TRANSACTION_SYNC_RETRIES=6
PLAID_LINK_TRANSACTION_SYNC_RETRY_MS=2000

# Google sign-in
GOOGLE_CLIENT_ID=replace-with-google-oauth-web-client-id

# Real estate valuation
RENTCAST_API_KEY=replace-with-rentcast-api-key
RENTCAST_BASE_URL=https://api.rentcast.io/v1
RENTCAST_TIMEOUT_MS=10000

# Real estate address autocomplete
MAPBOX_ACCESS_TOKEN=replace-with-mapbox-access-token
MAPBOX_SEARCH_BASE_URL=https://api.mapbox.com/search/searchbox/v1
MAPBOX_TIMEOUT_MS=5000

# Demo account
DEMO_USER_EMAIL=demo@example.com
