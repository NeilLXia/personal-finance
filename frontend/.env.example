# Copy to `.env` for local development. Only the Vite dev server reads this file.

# Vite dev proxy target for /api/* (frontend runs on :3000, backend on :8001).
API_HOST=http://127.0.0.1:8001

# The deployed Cloudflare Worker / Pages Function proxy reads BACKEND_ORIGIN from
# the Cloudflare environment, not from this file. For local `wrangler dev`, set it
# in `.dev.vars` (see .dev.vars.example).
